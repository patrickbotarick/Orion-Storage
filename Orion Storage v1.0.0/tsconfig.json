{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@orion/domain": ["./packages/domain/src/index.ts"],
      "@orion/shared": ["./packages/shared/src/index.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["src", "server", "packages"]
}
